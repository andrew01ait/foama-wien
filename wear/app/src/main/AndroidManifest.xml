    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application android:name="at.foama.wien.FoamaApplication" android:label="foama-wien" android:icon="@drawable/app_icon" android:roundIcon="@drawable/app_icon" android:allowBackup="false" android:theme="@style/FoamaTheme" android:usesCleartextTraffic="false" android:enableOnBackInvokedCallback="true">
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true"/>
